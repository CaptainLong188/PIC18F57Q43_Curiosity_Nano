  3922                           ;Config register CONFIG1 @ 0x300000
  3923                           ;	External Oscillator Selection
  3924                           ;	FEXTOSC = OFF, Oscillator not enabled
  3925                           ;	Reset Oscillator Selection
  3926                           ;	RSTOSC = HFINTOSC_64MHZ, HFINTOSC with HFFRQ = 64 MHz and CDIV = 1:1
  3927   300000                     	org	3145728
  3928   300000  8C                 	db	140
  3929                           
  3930                           ;Config register CONFIG2 @ 0x300001
  3931                           ;	Clock out Enable bit
  3932                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
  3933                           ;	PRLOCKED One-Way Set Enable bit
  3934                           ;	PR1WAY = OFF, PRLOCKED bit can be set and cleared repeatedly
  3935                           ;	Clock Switch Enable bit
  3936                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
  3937                           ;	Fail-Safe Clock Monitor Enable bit
  3938                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
  3939   300001                     	org	3145729
  3940   300001  FD                 	db	253
  3941                           
  3942                           ;Config register CONFIG3 @ 0x300002
  3943                           ;	MCLR Enable bit
  3944                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
  3945                           ;	Power-up timer selection bits
  3946                           ;	PWRTS = PWRT_OFF, PWRT is disabled
  3947                           ;	Multi-vector enable bit
  3948                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
  3949                           ;	IVTLOCK bit One-way set enable bit
  3950                           ;	IVT1WAY = ON, IVTLOCKED bit can be cleared and set only once
  3951                           ;	Low Power BOR Enable bit
  3952                           ;	LPBOREN = OFF, Low-Power BOR disabled
  3953                           ;	Brown-out Reset Enable bits
  3954                           ;	BOREN = OFF, Brown-out Reset disabled
  3955   300002                     	org	3145730
  3956   300002  3F                 	db	63
  3957                           
  3958                           ;Config register CONFIG4 @ 0x300003
  3959                           ;	Brown-out Reset Voltage Selection bits
  3960                           ;	BORV = VBOR_1P9, Brown-out Reset Voltage (VBOR) set to 1.9V
  3961                           ;	ZCD Disable bit
  3962                           ;	ZCD = OFF, ZCD module is disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCD
      +                          CON
  3963                           ;	PPSLOCK bit One-Way Set Enable bit
  3964                           ;	PPS1WAY = ON, PPSLOCKED bit can be cleared and set only once; PPS registers remain loc
      +                          ked after one clear/set cycle
  3965                           ;	Stack Full/Underflow Reset Enable bit
  3966                           ;	STVREN = ON, Stack full/underflow will cause Reset
  3967                           ;	Low Voltage Programming Enable bit
  3968                           ;	LVP = ON, Low voltage programming enabled. MCLR/VPP pin function is MCLR. MCLRE config
      +                          uration bit is ignored
  3969                           ;	Extended Instruction Set Enable bit
  3970                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
  3971   300003                     	org	3145731
  3972   300003  FF                 	db	255
  3973                           
  3974                           ;Config register CONFIG5 @ 0x300004
  3975                           ;	WDT Period selection bits
  3976                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
  3977                           ;	WDT operating mode
  3978                           ;	WDTE = OFF, WDT Disabled; SWDTEN is ignored
  3979   300004                     	org	3145732
  3980   300004  9F                 	db	159
  3981                           
  3982                           ;Config register CONFIG6 @ 0x300005
